# Media Hub Docker 部署环境变量示例。
# 使用前请复制为 ".env"，再按你的实际环境填写：
#   cp .env.example .env
#
# 说明：
# - 下面所有变量都故意不写默认值，避免把示例值误当成生产配置。
# - 标注为「必填」的变量建议首次启动前填写。
# - 标注为「非必填」的变量可以留空，Docker Compose 或程序会使用内置默认值，或后续在后台配置。
# - 不要把填写了真实密钥、Cookie、Token 的 ".env" 提交到 GitHub。

# 镜像配置。
# 非必填：主程序镜像。留空时 docker-compose.yml 使用公开镜像 liushuangxidocker/media-hub:latest。
MEDIA_HUB_IMAGE=
# 非必填：PostgreSQL 镜像。留空时使用 postgres:16-alpine。
POSTGRES_IMAGE=
# 非必填：Redis 镜像。留空时使用 redis:7-alpine。
REDIS_IMAGE=

# Web / 后台访问地址。
# 非必填：宿主机暴露端口。留空时使用 8080。
APP_PORT=
# 必填：用户实际访问 Media Hub 的公网或内网地址，生产环境建议使用 HTTPS 域名。
PUBLIC_BASE_URL=
# 非必填：运行环境。留空时使用 production。
APP_ENV=

# PostgreSQL 数据库配置。
# 非必填：数据库用户名。留空时使用 emby_plus。
POSTGRES_USER=
# 必填：数据库密码。请使用强密码。
POSTGRES_PASSWORD=
# 非必填：数据库名。留空时使用 emby_plus。
POSTGRES_DB=
# 必填：应用连接数据库的完整连接串，密码必须和 POSTGRES_PASSWORD 保持一致。
DATABASE_URL=

# 初始管理员账号。
# 非必填：初始管理员用户名。留空时使用 admin。
BOOTSTRAP_ADMIN_USERNAME=
# 必填：初始管理员密码。只在系统还没有管理员时创建，首次登录后建议立刻修改。
BOOTSTRAP_ADMIN_PASSWORD=
# 非必填：初始管理员邮箱。
BOOTSTRAP_ADMIN_EMAIL=

# 运行时加密密钥。
# 必填：用于加密后台集成配置、账号凭据等敏感数据。首次部署后不要随意更换。
# 生成方式示例：openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
# 必填：用于加密卡密明文等敏感数据。首次部署后不要随意更换。
# 生成方式示例：openssl rand -hex 32
CARD_PLAINTEXT_ENCRYPTION_KEY=

# Stripe 支付配置。
# 非必填：不启用 Stripe 支付时留空；后续也可以在后台集成配置里维护。
STRIPE_SECRET_KEY=
# 非必填：不启用 Stripe Webhook 时留空。
STRIPE_WEBHOOK_SECRET=

# SMTP 邮件通知配置。
# 非必填：不配置也能启动，但注册卡、订单、工单等邮件通知不会发送。
SMTP_HOST=
# 非必填：SMTP 端口。留空时使用 587。
SMTP_PORT=
# 非必填：SMTP 用户名。
SMTP_USERNAME=
# 非必填：SMTP 密码。
SMTP_PASSWORD=
# 非必填：发件人地址，例如 Media Hub <noreply@example.com>。
SMTP_FROM=
# 非必填：TLS 模式。留空时使用 starttls。
SMTP_TLS_MODE=

# Telegram 通知配置。
# 非必填：不使用 Telegram 通知时留空。
TELEGRAM_BOT_TOKEN=
# 非必填：管理员接收通知的 Telegram chat id。
TELEGRAM_ADMIN_CHAT_ID=

# TMDB 元数据 / 媒体搜索配置。
# 非必填但建议配置：不填会影响媒体搜索、海报和元数据增强能力。
TMDB_API_KEY=
# 非必填：TMDB 语言。留空时使用 zh-CN。
TMDB_LANGUAGE=
# 非必填：TMDB 地区。留空时使用 CN。
TMDB_REGION=

# HDHive 集成配置。
# 非必填：用于资源搜索、资源解锁和工单处理；不用 HDHive 时留空。
HDHIVE_BASE_URL=
# 非必填：HDHive API Key。
HDHIVE_API_KEY=
# 非必填：HDHive Access Token。
HDHIVE_ACCESS_TOKEN=
# 非必填：HDHive 请求代理。
HDHIVE_PROXY_URL=

# Emby 用户导入默认密码。
# 非必填：从 Emby 导入用户时，如果需要为本系统账号设置统一初始密码，可以填写。
EMBY_IMPORT_DEFAULT_PASSWORD=

# Emby 兼容播放配置。
# 非必填：播放模式。留空时使用 auto。
EMBY_COMPAT_STREAM_MODE=
# 非必填：播放链接缓存秒数。留空时使用 600。
EMBY_COMPAT_STREAM_CACHE_TTL_SECONDS=

# 115 兼容变量。
# 非必填：普通部署建议留空，后续在后台 115 页面扫码、配置账号池和扫描方案。
EMBY_COMPAT_115_RESOLVER_URL=
# 非必填：115 Open API access token。不要提交真实 token。
EMBY_COMPAT_115_ACCESS_TOKEN=
# 非必填：115 Cookie。不要提交真实 cookie。
EMBY_COMPAT_115_COOKIE=
# 非必填：多账号 JSON。优先使用后台页面保存，后台会加密存储。
EMBY_COMPAT_115_ACCOUNTS_JSON=
# 非必填：115 Open API 下载地址覆盖。
EMBY_COMPAT_115_OPEN_DOWN_URL=
# 非必填：115 Web 下载地址覆盖。
EMBY_COMPAT_115_WEB_DOWNLOAD_URL=
# 非必填：115 取链缓存秒数。留空时使用 600。
EMBY_COMPAT_115_CACHE_TTL_SECONDS=

# CloudDrive2 / 大盘挂小盘物化配置。
# 非必填：不使用大盘挂小盘、CloudDrive2 或物化能力时全部留空。
CLOUDDRIVE2_ENABLED=
CLOUDDRIVE2_GRPC_ADDR=
CLOUDDRIVE2_USERNAME=
CLOUDDRIVE2_PASSWORD=
CLOUDDRIVE2_TOKEN=
# 非必填：物化全局并发。留空时使用 1。
MATERIALIZE_GLOBAL_MAX_CONCURRENT=
# 非必填：物化等待超时秒数。留空时使用 20。
MATERIALIZE_WAIT_TIMEOUT_SECONDS=
# 非必填：物化 provider 列表，例如 115_instant、clouddrive2。
MATERIALIZE_PROVIDERS=
# 非必填：是否允许分享链接兜底。留空时为 false。
MATERIALIZE_ALLOW_SHARE_FALLBACK=

# ffprobe 媒体探测配置。
# 非必填：如需服务端探测视频编码、时长、分辨率等信息，填写 ffprobe 可执行文件路径。
FFPROBE_PATH=
# 非必填：是否启用播放后机会探测。留空时为 false。
EMBY_COMPAT_OPPORTUNISTIC_PROBE=
# 非必填：探测超时秒数。留空时使用 8。
EMBY_COMPAT_PROBE_TIMEOUT_SECONDS=
# 非必填：探测并发数。留空时使用 1。
EMBY_COMPAT_PROBE_CONCURRENCY=
